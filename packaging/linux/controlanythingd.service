# systemd unit for the ControlAnything daemon (root: writes to /sys/class/hwmon and /etc/controlanything).
[Unit]
Description=ControlAnything - PC control daemon
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/bin/controlanythingd
Restart=on-failure
RestartSec=5
# SIGTERM -> clean shutdown: fans handed back to the BIOS (pwm*_enable restored)
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
